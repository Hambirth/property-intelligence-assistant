# Application
APP_ENV=development
APP_NAME=Property Intelligence API
LOG_LEVEL=INFO

# Local Docker PostgreSQL. Replace every credential in a real deployment.
POSTGRES_DB=property_intelligence
POSTGRES_USER=property_app
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://property_app:local_dev_password@localhost:5432/property_intelligence
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800

# Browser/API origins
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# LLM (the key is intentionally optional during Phase 2)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2

# Phase 4 local retrieval. The selected model and database vector dimension are fixed together.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_TARGET_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=120
RAG_CHUNK_MIN_CHARS=180
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.61
RAG_CONTEXT_MAX_CHUNKS=6
RAG_CONTEXT_MAX_CHARS=7000
MAX_CHAT_MESSAGE_LENGTH=2000
MAX_CHAT_BODY_BYTES=8192
REQUEST_TIMEOUT_SECONDS=30
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_IPS=
ALLOW_LOCALHOST_ORIGINS=false
EMBEDDING_PRELOAD=false

# Respectful crawler limits
SCRAPER_USER_AGENT=PropertyIntelligenceBot/0.1 (+https://example.com/crawler)
SCRAPER_CONNECT_TIMEOUT_SECONDS=10
SCRAPER_READ_TIMEOUT_SECONDS=20
SCRAPER_TOTAL_TIMEOUT_SECONDS=30
SCRAPER_REQUEST_DELAY_SECONDS=1
SCRAPER_MAX_CONCURRENCY=2
SCRAPER_MAX_RETRIES=2
SCRAPER_MAX_RESPONSE_BYTES=20000000
SCRAPER_DEFAULT_LIMIT=100
